# Anthropic API key — required for real LLM usage (Steps 01-04, spec §9).
# Not needed for mock-only runs or tests.
ANTHROPIC_API_KEY=

# LLM provider selection: "anthropic" (default) or "mock" (offline, deterministic,
# zero cost — used by tests and the phase verification gates, spec §15).
KB_LLM_PROVIDER=anthropic

# Anthropic model ID. Empty → provider default (claude-sonnet-4-5).
# For low-cost development use a cheaper model, e.g.:
#   KB_LLM_MODEL=claude-haiku-4-5
KB_LLM_MODEL=

# LLM creativity (sampling temperature) for all text generation, 0.0-1.0.
# 0.0 = focused and highly reproducible; 1.0 = most varied ideas and prose.
# Empty → provider default. Suggested: 0.3 for careful revisions, 0.8 for first drafts.
KB_LLM_TEMPERATURE=

# Image provider selection: "mock" (default, offline) or "imagen" (Google image models, Phase 4).
KB_IMAGE_PROVIDER=mock

# Google AI Studio API key (https://aistudio.google.com/apikey).
# Required when KB_IMAGE_PROVIDER=imagen. Note: classic Imagen :predict models are
# closed to new users; the provider targets Gemini image models (e.g. gemini-3.1-flash-image).
GOOGLE_API_KEY=

# Gemini image model ID. Empty → provider default (gemini-3.1-flash-image).
# For higher quality (and cost) use e.g.: KB_IMAGE_MODEL=gemini-3-pro-image
KB_IMAGE_MODEL=

# Path to a Google service-account JSON — only for the Vertex AI route (optional alternative).
GOOGLE_APPLICATION_CREDENTIALS=

# Maximum parallel image-generation requests (spec §7.3). Default: 4.
KB_MAX_CONCURRENCY=4

# Logging verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL. Default: INFO.
KB_LOG_LEVEL=INFO
